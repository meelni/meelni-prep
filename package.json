{
  "name": "meelni",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "doctor": "node scripts/doctor-local.mjs",
    "env:pull": "node scripts/pull-vercel-env.mjs .env.local preview",
    "env:pull:preview": "node scripts/pull-vercel-env.mjs .env.local preview",
    "env:pull:production": "node scripts/pull-vercel-env.mjs .env.production.local production",
    "env:adopt:preview": "node scripts/pull-vercel-env.mjs .env.local preview --adopt-existing",
    "env:adopt:production": "node scripts/pull-vercel-env.mjs .env.production.local production --adopt-existing",
    "dev:local": "node scripts/start-local-dev.mjs",
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:inngest": "npx --yes inngest-cli@latest dev --sdk-url http://127.0.0.1:3000/api/inngest",
    "dev:agent": "cd agent && source venv/bin/activate && python agent.py dev",
    "build": "next build",
    "start": "next start",
    "check": "npm run format:check:quality && npm run lint && npm run typecheck && npm run typecheck:tests && npm run quality",
    "check:ci": "npm run check && npm run test:product-language && npm run test:core && npm run test:agent && npm run test:integrations && npm run test:fixtures && npm run test:workflows && npm run test:api && npm run test:auth-ui && npm run test:billing && npm run test:operations && npm run test:content && npm run test:packages",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit --project tsconfig.tests.json",
    "typecheck:tests:all": "tsc --noEmit --project tsconfig.tests.all.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:check:quality": "prettier --check biome.jsonc dependency-cruiser.config.cjs knip.jsonc tsconfig.tests.json tsconfig.tests.all.json .semgrep.yml scripts/quality-scripts.test.mjs scripts/run-semgrep.mjs docs/operations/code-quality-checks.md",
    "quality": "npm run quality:biome && npm run quality:deps && npm run quality:boundaries && npm run quality:security && npm run test:quality",
    "quality:biome": "biome ci --json-formatter-enabled=false biome.jsonc package.json tsconfig.json tsconfig.tests.json tsconfig.tests.all.json eslint.config.mjs dependency-cruiser.config.cjs knip.jsonc scripts/quality-scripts.test.mjs scripts/run-semgrep.mjs",
    "quality:biome:all": "biome ci .",
    "quality:biome:fix": "biome check --write .",
    "quality:deps": "knip --config knip.jsonc --include unlisted,unresolved --no-config-hints",
    "quality:deps:all": "knip --config knip.jsonc --no-config-hints",
    "quality:boundaries": "depcruise --config dependency-cruiser.config.cjs app components lib packages scripts --output-type err",
    "quality:security": "node scripts/run-semgrep.mjs",
    "analyze": "ANALYZE=true next build",
    "db:generate": "drizzle-kit generate",
    "db:preflight": "tsx scripts/database-migration-preflight.ts",
    "db:preflight:preview": "MEELNI_ENV_FILE=.env.local npm run db:preflight",
    "db:preflight:production": "MEELNI_ENV_FILE=.env.production.local npm run db:preflight",
    "db:migrate": "node scripts/database-command.mjs migrate",
    "db:migrate:preview": "MEELNI_ENV_FILE=.env.local npm run db:migrate",
    "db:migrate:production": "MEELNI_ENV_FILE=.env.production.local npm run db:migrate",
    "db:push": "node scripts/database-command.mjs push",
    "db:studio": "node scripts/database-command.mjs studio",
    "db:check": "drizzle-kit check",
    "stripe:setup-catalog": "node scripts/setup-stripe-credit-catalog.mjs",
    "sync:questions": "tsx scripts/run-question-sync.ts",
    "test:agent": "tsx --test packages/agent/src/*.test.ts",
    "test:core": "tsx --test packages/core/src/*.test.ts",
    "test:integrations": "tsx --test packages/integrations/src/*.test.ts",
    "test:database-migrations": "tsx scripts/test-database-migrations.ts",
    "test:python-agent": "python3 -m unittest agent/test_runtime_contracts.py",
    "test:local": "node --test scripts/*.test.mjs",
    "test:fixtures": "tsx --test packages/test-fixtures/src/*.test.ts",
    "test:content": "tsx --test lib/blog-data.test.ts components/explore/structured-data.test.tsx && node --test scripts/content-credibility-contract.test.mjs",
    "test:workflows": "tsx --test lib/workflows/*.test.ts lib/db/*.test.ts lib/question-sync/*.test.ts lib/security/*.test.ts lib/supabase/*.test.ts lib/auth/*.test.ts lib/navigation/*.test.ts lib/analytics/*.test.ts lib/dashboard/*.test.ts",
    "test:api": "vitest run app/auth/callback/route.test.ts app/api/interview/end/__tests__/route.test.ts app/api/feedback/[sessionId]/route.test.ts app/api/checkout/create-session/route.test.ts app/api/webhooks/stripe/route.test.ts app/api/user/export/route.test.ts app/api/user/delete/route.test.ts",
    "test:auth-ui": "tsx --test components/auth/*.test.tsx && vitest run components/explore/question-signin-modal.test.tsx app/auth/*.test.tsx",
    "test:billing": "tsx --test lib/billing/*.test.ts",
    "test:operations": "tsx --test lib/operations/*.test.ts && node --test scripts/check-service-health.test.mjs",
    "test:packages": "tsx --test scripts/package-entrypoints.test.ts",
    "test:quality": "node --test scripts/quality-scripts.test.mjs",
    "test:product-language": "tsx --test lib/product-language.test.ts && node --test scripts/product-language-contract.test.mjs",
    "auth:doctor": "node scripts/auth-doctor.mjs",
    "auth:doctor:db": "node scripts/auth-doctor.mjs --db",
    "health:synthetic": "tsx scripts/check-service-health.ts",
    "test:sheets": "tsx scripts/test-google-sheets-connection.ts",
    "test:feedback": "tsx --env-file=.env.local scripts/test-feedback-generation.ts",
    "validate:skills": "node scripts/validate-skills.mjs",
    "validate:env": "tsx --env-file=.env.local scripts/validate-env.ts",
    "verify:agent": "node scripts/verify-agent.mjs",
    "ralph": "./scripts/ralph/ralph.sh",
    "ralph:status": "cat scripts/ralph/prd.json | jq '.userStories[] | {id, title, passes}'",
    "ralph:progress": "cat scripts/ralph/progress.txt"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.22.0",
    "@elevenlabs/react": "^0.9.1",
    "@livekit/components-react": "^2.9.15",
    "@meelni/agent": "file:packages/agent",
    "@meelni/core": "file:packages/core",
    "@meelni/integrations": "file:packages/integrations",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.10.96",
    "@statsig/js-client": "^3.33.3",
    "@statsig/session-replay": "^3.33.3",
    "@statsig/web-analytics": "^3.33.3",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.79.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.7",
    "@types/three": "^0.181.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.23.24",
    "googleapis": "^165.0.0",
    "inngest": "^3.54.2",
    "livekit-client": "^2.15.14",
    "livekit-server-sdk": "^2.14.0",
    "lucide-react": "^0.552.0",
    "motion": "^12.23.24",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "openai": "^6.8.1",
    "posthog-js": "^1.295.0",
    "posthog-node": "^5.11.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "rehype-pretty-code": "^0.14.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "server-only": "^0.0.1",
    "shiki": "^3.14.0",
    "sonner": "^2.0.7",
    "streamdown": "^1.4.0",
    "stripe": "^19.3.1",
    "swagger-ui-react": "^5.30.2",
    "tailwind-merge": "^3.3.1",
    "three": "^0.181.1",
    "unified": "^11.0.5",
    "use-stick-to-bottom": "^1.1.1",
    "usehooks-ts": "^3.1.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swagger-ui-react": "^5.18.0",
    "dependency-cruiser": "18.0.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "jsdom": "^29.1.1",
    "knip": "6.25.0",
    "postgres": "^3.4.7",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
