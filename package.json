{
  "name": "meelni",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "doctor": "node scripts/doctor-local.mjs",
    "dev:local": "node scripts/start-local-dev.mjs",
    "dev": "next dev",
    "dev:web": "next dev",
    "dev:agent": "cd agent && source venv/bin/activate && python agent.py dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze": "ANALYZE=true next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "sync:questions": "tsx scripts/sync-questions-from-sheet.ts",
    "test:agent": "tsx --test packages/agent/src/*.test.ts",
    "test:core": "tsx --test packages/core/src/*.test.ts",
    "test:integrations": "tsx --test packages/integrations/src/*.test.ts",
    "test:python-agent": "python3 -m unittest agent/test_runtime_contracts.py",
    "test:local": "node --test scripts/*.test.mjs",
    "test:sheets": "tsx scripts/test-google-sheets-connection.ts",
    "test:feedback": "tsx --env-file=.env.local scripts/test-feedback-generation.ts",
    "validate:env": "tsx --env-file=.env.local scripts/validate-env.ts",
    "ralph": "./scripts/ralph/ralph.sh",
    "ralph:status": "cat scripts/ralph/prd.json | jq '.userStories[] | {id, title, passes}'",
    "ralph:progress": "cat scripts/ralph/progress.txt"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.22.0",
