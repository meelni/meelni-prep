      "id": "US-001",
      "title": "Add database table for feature",
      "description": "Create the necessary database schema",
      "acceptanceCriteria": [
        "Add new table to /lib/db/schema.ts",
        "Include id, userId, createdAt columns minimum",
        "Add foreign key to app_user table",
        "Run npm run db:push successfully",
        "npm run typecheck passes"
      ],
      "priority": 1,
      "passes": false,
      "notes": ""
    },
    {
      "id": "US-002",
      "title": "Create API endpoint",
      "description": "Add API route for the feature",
      "acceptanceCriteria": [
        "Create /app/api/[feature]/route.ts",
        "Implement GET handler with auth check",
        "Return proper JSON response",
        "Handle errors with appropriate status codes",
        "npm run typecheck passes",
        "npm run lint passes"
      ],
      "priority": 2,
      "passes": false,
      "notes": ""
    },
    {
