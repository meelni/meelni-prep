{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@meelni/core": ["./packages/core/src/index.ts"],
      "@meelni/agent": ["./packages/agent/src/index.ts"],
      "@meelni/integrations": ["./packages/integrations/src/index.ts"],
      "@meelni/integrations/opik": ["./packages/integrations/src/opik.ts"],
      "@meelni/test-fixtures": ["./packages/test-fixtures/src/index.ts"],
      "@meelni/test-fixtures/synthetic-feedback": [
        "./packages/test-fixtures/src/synthetic-feedback.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**"
  ]
}
