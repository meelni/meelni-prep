# Database (Supabase)
DATABASE_URL=postgresql://...

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...

# LiveKit
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# OpenAI (for GPT-4.1-mini dialogue + GPT-4 Turbo evaluation)
OPENAI_API_KEY=sk-proj-xxx

# Deepgram (ASR - Nova-3)
DEEPGRAM_API_KEY=xxx

# Stripe (Subscription billing)
# Get these from https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_live_xxx  # Use sk_live_xxx for production, sk_test_xxx for development
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx  # Use pk_live_xxx for production, pk_test_xxx for development
STRIPE_WEBHOOK_SECRET=whsec_xxx  # From webhook endpoint settings

# Stripe Price IDs (from Products page)
# Note: Only Pro tier is active. Premium tier variables kept for backwards compatibility.
STRIPE_PRO_MONTHLY_PRICE_ID=price_xxx
STRIPE_PRO_ANNUAL_PRICE_ID=price_xxx
STRIPE_PREMIUM_MONTHLY_PRICE_ID=  # Not used - Premium tier removed
STRIPE_PREMIUM_ANNUAL_PRICE_ID=  # Not used - Premium tier removed

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx  # Client-side tracking (safe to expose)
POSTHOG_SERVER_KEY=phx_xxx  # Server-side tracking (keep secret)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000  # Use https://meelni.com for production

# Optional Services (Phase 1+)
# Inngest (background jobs)
# INNGEST_EVENT_KEY=xxx
# INNGEST_SIGNING_KEY=xxx

# Resend (email)
# RESEND_API_KEY=xxx

# Sentry (error tracking)
# SENTRY_DSN=xxx
