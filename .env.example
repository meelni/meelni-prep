# Database (Supabase)
DATABASE_URL=postgresql://...

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...
# Non-secret 20-character ref for the Production Supabase project. Configure
# the same value in Preview and Production so database tooling can prove its target.
MEELNI_PRODUCTION_SUPABASE_PROJECT_REF=rarrrwkjuhfyfatcmrkw
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# LiveKit
# Production public identities are shown below. Preview must use its separately
# provisioned project and agent dispatch names; never copy Production values there.
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_INTERVIEW_AGENT_NAME=CA_yawKG67rCMG4
LIVEKIT_DEMO_AGENT_NAME=CA_t3sKQEihMQ7x

# Server-owned interview runtime settings. Configure the same values on the
# web and voice-agent deployments; never expose these as NEXT_PUBLIC_* values.
MEELNI_INTERVIEW_STT_MODEL=deepgram/nova-3
MEELNI_INTERVIEW_LLM_MODEL=openai/gpt-4.1-mini
MEELNI_INTERVIEW_TTS_MODEL=cartesia/sonic-3:6ccbfb76-1fc6-48f7-b71d-91ac6298247b
MEELNI_INTERVIEW_VOICE=cgSgspJ2msm6clMCkdW9
MEELNI_INTERVIEW_TTS_SPEED=1.0
MEELNI_INTERVIEW_TTS_EMOTION=professional
MEELNI_INTERVIEW_TTS_VOLUME=1.0

# OpenAI (for server-owned interview dialogue and post-interview feedback evaluation)
OPENAI_API_KEY=sk-proj-xxx
# Pin the accepted feedback model explicitly in deployed environments.
OPENAI_FEEDBACK_MODEL=gpt-5.1

# Deepgram (ASR - Nova-3)
DEEPGRAM_API_KEY=xxx

# Stripe (credit billing)
# Use sk_test or rk_test with pk_test in Preview; use sk_live or rk_live with
# pk_live in Production. The deployment preflight verifies each price read-only.
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Price IDs (from Products -> Prices)
STRIPE_INTERVIEW_PASS_PRICE_ID=price_xxx
STRIPE_STARTER_MONTHLY_PRICE_ID=price_xxx
STRIPE_PRO_MONTHLY_PRICE_ID=price_xxx

# Google Sheets question bank
GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/1rz10oEeLx-eGnilahKczYPhGfCUzIEKL-xRnjoQ-SX4/gviz/tq?tqx=out:csv&gid=0
GOOGLE_SHEET_ID=1rz10oEeLx-eGnilahKczYPhGfCUzIEKL-xRnjoQ-SX4
GOOGLE_SHEET_NAME=Form Responses 1
# Offset-less Google Forms timestamps use this fixed source offset. Named IANA
# zones are rejected to avoid DST ambiguity; use UTC or a numeric offset.
GOOGLE_SHEET_TIME_ZONE=UTC
# Server-only, independently generated sync credentials. Blank or weak values fail closed.
CRON_SECRET=
QUESTION_SYNC_OPERATOR_SECRET=
# Optional private/API fallbacks:
# GOOGLE_SHEETS_API_KEY=xxx
# GOOGLE_SHEETS_CREDENTIALS_BASE64=xxx

# Analytics (PostHog)
# Get these from: https://app.posthog.com/project/settings/keys
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx  # Project API Key - Client-side tracking (safe to expose)
POSTHOG_SERVER_KEY=phx_xxx  # Personal API Key - Server-side tracking (keep secret)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Feature Flags (Statsig)
# Client key is safe to expose in the browser.
NEXT_PUBLIC_STATSIG_CLIENT_KEY=client-xkQhgB6QEBeJyiHQ1AxfetHx8Zb200QDYmXapeZr2NC
NEXT_PUBLIC_STATSIG_ENVIRONMENT=development
# Server fallback when Statsig is unavailable. Keep false before relaunch; the
# launch/rollback runbook changes this together with the global gate.
MEELNI_REACTIVATION_DEFAULT=false
# Phase is target-bound: Preview uses rehearsal with the gate default-off;
# Production remains prelaunch until the owner-authorized launch change.
MEELNI_RELAUNCH_PHASE=prelaunch
# Preview only: set this branch-scoped Vercel variable to the exact reviewed
# 40-character commit SHA. Leave blank for local and ordinary previews.
MEELNI_REHEARSAL_COMMIT_SHA=
# Required in Preview/Production so Statsig uses the same-origin proxy.
NEXT_PUBLIC_STATSIG_API_URL=/api/statsig

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000  # Use https://meelni.com for production

# Inngest (required in Preview/Production for feedback and durable jobs)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Resend (email)
# RESEND_API_KEY=xxx

# Sentry (error tracking)
# SENTRY_DSN=xxx
