# Database (Supabase)
DATABASE_URL=postgresql://...

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...

# LiveKit
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# OpenAI (for GPT-4.1-mini dialogue + GPT-4 Turbo evaluation)
OPENAI_API_KEY=sk-proj-xxx

# Deepgram (ASR - Nova-3)
DEEPGRAM_API_KEY=xxx

# Stripe (credit billing)
# Use sk_test/pk_test locally and sk_live/pk_live in production.
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Price IDs (from Products -> Prices)
STRIPE_INTERVIEW_PASS_PRICE_ID=price_xxx
STRIPE_STARTER_MONTHLY_PRICE_ID=price_xxx
STRIPE_PRO_MONTHLY_PRICE_ID=price_xxx

# Analytics (PostHog)
# Get these from: https://app.posthog.com/project/settings/keys
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx  # Project API Key - Client-side tracking (safe to expose)
POSTHOG_SERVER_KEY=phx_xxx  # Personal API Key - Server-side tracking (keep secret)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Feature Flags (Statsig)
# Client key is safe to expose in the browser.
NEXT_PUBLIC_STATSIG_CLIENT_KEY=client-xkQhgB6QEBeJyiHQ1AxfetHx8Zb200QDYmXapeZr2NC
NEXT_PUBLIC_STATSIG_ENVIRONMENT=development
# Optional: useful locally if Statsig's default SDK domains are blocked by the browser/network.
NEXT_PUBLIC_STATSIG_API_URL=/api/statsig

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000  # Use https://meelni.com for production

# Optional Services (Phase 1+)
# Inngest (background jobs)
# INNGEST_EVENT_KEY=xxx
# INNGEST_SIGNING_KEY=xxx

# Resend (email)
# RESEND_API_KEY=xxx

# Sentry (error tracking)
# SENTRY_DSN=xxx
